ype":"text","text":"​"}]},"editableTextNodeIds":[],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000151","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000053","type":"heading","editable":true,"label":"h2","sourcePath":"root/53","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000152","type":"element","tag":"h2","attrs":{"id":"revolution-strategy"},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000153","type":"element","tag":"ins","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000154","type":"text","text":"Revolution++ Strategy"}]}]},"editableTextNodeIds":["pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000154"],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000155","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000055","type":"paragraph","editable":true,"label":"p","sourcePath":"root/55","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000156","type":"element","tag":"p","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000157","type":"text","text":"It’s possible to “semi-AFK” the Dagannoth Kings by switching weapons and using revolution, even without any hybrid armour. Normally, using armour that’s off-style has an accuracy penalty i.e. if using a Melee weapon, then magic/ranged armour will lower accuracy. For DKs, a combination of T90 weapons + overloads + T80 power armour of different styles will ensure 100% accuracy on all three kings. Higher armour or lower tier weapons will affect accuracy, but adding prayers/curses will get accuracy back up to 100%."}]},"editableTextNodeIds":["pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000157"],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000158","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000057","type":"paragraph","editable":false,"label":"p","sourcePath":"root/57","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000159","type":"element","tag":"p","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000160","type":"text","text":"​"}]},"editableTextNodeIds":[],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000161","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000059","type":"paragraph","editable":true,"label":"p","sourcePath":"root/59","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000162","type":"element","tag":"p","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000163","type":"text","text":"The strategy here is to wear power armour of different types i.e. (melee helm, ranged body, magic legs), and swap weapons/prayer for each king. This requires two clicks/key binds every kill, but is otherwise auto-pilot."}]},"editableTextNodeIds":["pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000163"],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000164","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000061","type":"paragraph","editable":false,"label":"p","sourcePath":"root/61","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000165","type":"element","tag":"p","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000166","type":"text","text":"​"}]},"editableTextNodeIds":[],"tail":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000167","type":"text","text":"\n"}},{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:b:000063","type":"paragraph","editable":true,"label":"p","sourcePath":"root/63","node":{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:000168","type":"element","tag":"p","attrs":{},"children":[{"id":"pvme-guides--rs3-full-boss-guides--dagannoth-kings:n:00